# Catnip Agent 环境变量
# 复制本文件为 .env.local 或放入 .local-secrets/deepseek.env

# DeepSeek API Key（必填，用于模型调用）
DEEPSEEK_API_KEY=your_key_here

# Runner 配置
CATNIP_RUNNER_PROVIDER=heuristic
CATNIP_RUNNER_MAX_STEPS=10
CATNIP_RUNNER_MAX_TOOL_RETRIES=2
CATNIP_RUNNER_CONTINUE_ON_TOOL_ERROR=false
CATNIP_RUN_TIMEOUT_MS=180000

# Worker 配置
CATNIP_WORKER_COUNT=1
CATNIP_WORKER_HEARTBEAT_MS=5000

# Memory 配置
CATNIP_MEMORY_STORAGE_FILE=logs/catnip-memory.json

# 浏览器配置（Windows 用 start，Linux/macOS 用 xdg-open）
CATNIP_BROWSER_OPEN_BIN=start
